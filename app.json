{
  "expo": {
    "name": "ВСВ ССО · Щоденник",
    "slug": "delic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ua.vsvsso.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e0f0f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ua.vsvsso.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#d3261c"
        }
      ]
    ],
    "scheme": "sofapp",
    "backgroundColor": "#0e0f0f",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "bookingUrl": null,
      "eas": {
        "projectId": "b14d7a40-7c5e-4f72-84a5-da854a8b0fd6"
      }
    },
    "owner": "dikranon"
  }
}
